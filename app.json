{
  "expo": {
    "name": "PaceNation",
    "slug": "pacenation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pacenation",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.pacenation",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PaceNation uses your location to map your route and measure distance and pace while you track an activity.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PaceNation keeps tracking your route when the screen is off during an activity you started.",
        "NSPhotoLibraryUsageDescription": "PaceNation lets you choose a profile picture from your photos.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "app.pacenation",
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "PaceNation",
      "themeColor": "#07111F",
      "backgroundColor": "#07111F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PaceNation keeps tracking your route when the screen is off during an activity you started.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PaceNation lets you choose a profile picture from your photos."
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "expo-web-browser",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07111F",
    "description": "Where Every Kilometre Matters. Track walks, runs and rides, join challenges and compete with a fitness community.",
    "extra": {
      "eas": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "nate0013-lab"
  }
}
