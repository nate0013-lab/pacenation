rules_version = '2';

// PaceNation Firestore security rules.
// Runs on the free Spark plan: no Cloud Functions, so every write comes
// from a device and these rules are the only line of defence. Clients
// write only their own content and tightly validated shared counters.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function follows(target) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(target)/followers/$(request.auth.uid));
    }
    // Shared visibility check for profiles and activities.
    function canSee(ownerId, visibility) {
      return isUser(ownerId)
        || (signedIn() && visibility == 'public')
        || (visibility == 'followers' && follows(ownerId));
    }
    function profileVisible(uid) {
      return canSee(uid, get(/databases/$(database)/documents/users/$(uid)).data.privacy.profileVisibility);
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validVisibility(v) { return v in ['public', 'followers', 'private']; }
    // XP and level are worked out on the device from saved activities. The level
    // must match the XP: reaching level L takes 125 * (L - 1) * (L + 2) XP.
    function validXp(d) {
      return d.xp is int && d.xp >= 0 && d.xp <= 50000000
        && d.level is int && d.level >= 1 && d.level <= 1000
        && 125 * (d.level - 1) * (d.level + 2) <= d.xp
        && d.xp < 125 * d.level * (d.level + 3);
    }
    function validPrivacy(p) {
      return p is map
        && p.keys().hasOnly(['profileVisibility', 'activityVisibility', 'showOnLeaderboards'])
        && p.keys().hasAll(['profileVisibility', 'activityVisibility', 'showOnLeaderboards'])
        && validVisibility(p.profileVisibility)
        && validVisibility(p.activityVisibility)
        && p.showOnLeaderboards is bool;
    }
    function validCard(d) {
      return d.username is string
        && d.usernameLower == d.username.lower()
        && d.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && d.bio is string && d.bio.size() <= 160
        // Photos are small JPEG data URLs (free plan, no Cloud Storage) or, later, https URLs.
        && (d.photoURL == null
            || (d.photoURL is string && d.photoURL.size() <= 200000
                && (d.photoURL.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') || d.photoURL.matches('^https://.*'))))
        && validPrivacy(d.privacy);
    }
    function ownsUsername(uid, name) {
      return getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid;
    }

    // ---------- users ----------
    match /users/{uid} {
      // The public card stays readable to signed-in users so people can find
      // and follow each other. Stats live in /stats and respect privacy.
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'displayName', 'bio', 'photoURL',
             'xp', 'level', 'followerCount', 'followingCount', 'privacy', 'createdAt', 'updatedAt'])
        && validCard(request.resource.data)
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ownsUsername(uid, request.resource.data.usernameLower);
      allow update: if isUser(uid)
        && changedOnly(['username', 'usernameLower', 'displayName', 'bio', 'photoURL', 'privacy', 'xp', 'level', 'updatedAt'])
        && validCard(request.resource.data)
        && validXp(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && ownsUsername(uid, request.resource.data.usernameLower);
      allow delete: if isUser(uid);

      match /private/{docId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && docId == 'settings'
          && request.resource.data.keys().hasOnly(['email', 'weightKg', 'units', 'notifications'])
          && (request.resource.data.weightKg == null
              || (request.resource.data.weightKg is number
                  && request.resource.data.weightKg >= 30 && request.resource.data.weightKg <= 250));
      }

      match /records/{recordId} {
        allow read: if profileVisible(uid);
        allow write: if false;
      }
      match /badges/{badgeId} {
        allow read: if profileVisible(uid);
        allow write: if false;
      }

      // Follow edges, always written as a pair in one batch. Public profiles can be
      // followed straight away; other profiles need an approved follow request, and
      // then the profile owner writes both edges while removing the request.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create: if followerId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(followerId)/following/$(uid))
          && (
            (isUser(followerId)
              && get(/databases/$(database)/documents/users/$(uid)).data.privacy.profileVisibility == 'public')
            || (isUser(uid)
              && exists(/databases/$(database)/documents/users/$(uid)/followRequests/$(followerId))
              && !existsAfter(/databases/$(database)/documents/users/$(uid)/followRequests/$(followerId)))
          );
        // Unfollow, or the profile owner removing a follower.
        allow delete: if isUser(followerId) || isUser(uid);
        allow update: if false;
      }
      match /following/{targetId} {
        allow read: if signedIn();
        // The followers rule above decides whether the pair is allowed.
        allow create: if (isUser(uid) || isUser(targetId)) && targetId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(targetId)/followers/$(uid));
        allow delete: if isUser(uid) || isUser(targetId);
        allow update: if false;
      }
      // Requests to follow a profile that is not public. Only the two people involved see them.
      match /followRequests/{requesterId} {
        allow read: if isUser(uid) || isUser(requesterId);
        allow create: if isUser(requesterId) && requesterId != uid
          && exists(/databases/$(database)/documents/users/$(uid))
          && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(requesterId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        // Cancelled by the requester, or approved or declined by the owner.
        allow delete: if isUser(uid) || isUser(requesterId);
        allow update: if false;
      }

      // Challenges I joined, written together with my participant entry.
      match /challenges/{challengeId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['joinedAt', 'endsAt'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.endsAt is timestamp
          && existsAfter(/databases/$(database)/documents/challenges/$(challengeId)/participants/$(uid));
        allow update: if false;
      }

      match /feed/{activityId} {
        allow read: if isUser(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid) && changedOnly(['read']) && request.resource.data.read is bool;
        allow create: if false;
      }
    }

    // Username reservations: one document per lowercase name.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;
      // Released only in the same write that renames or deletes the profile.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name);
      allow update: if false;
    }

    // ---------- stats ----------
    // Public summary of a user's activities (totals, XP, badges, records),
    // kept up to date by the owner's device whenever their activities change.
    match /stats/{uid} {
      allow read: if profileVisible(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['totals', 'bySport', 'week', 'month', 'xp', 'level', 'badges',
             'records', 'currentStreak', 'bestStreak', 'updatedAt'])
        && validXp(request.resource.data)
        && request.resource.data.totals is map
        && request.resource.data.bySport is map
        && request.resource.data.week is map
        && request.resource.data.month is map
        && request.resource.data.badges is map && request.resource.data.badges.size() <= 200
        && request.resource.data.records is map && request.resource.data.records.size() <= 50
        && request.resource.data.currentStreak is int && request.resource.data.bestStreak is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if isUser(uid);
    }

    // ---------- activities ----------
    function validActivity(d) {
      return d.sport in ['walk', 'run', 'ride']
        && validVisibility(d.visibility)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.distanceM is number && d.distanceM >= 0 && d.distanceM < 1000000
        && d.movingTimeS is number && d.movingTimeS >= 0 && d.movingTimeS < 172800
        && d.elapsedTimeS is number && d.elapsedTimeS >= d.movingTimeS
        && d.startedAt is timestamp && d.endedAt is timestamp && d.endedAt >= d.startedAt
        && d.endedAt <= request.time + duration.value(5, 'm');
    }
    function activityData(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data;
    }
    function canSeeActivity(activityId) {
      let a = activityData(activityId);
      return canSee(a.ownerId, a.visibility);
    }

    match /activities/{activityId} {
      allow read: if canSee(resource.data.ownerId, resource.data.visibility);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validActivity(request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if isUser(resource.data.ownerId)
        && changedOnly(['title', 'visibility', 'description'])
        && validActivity(request.resource.data)
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string && request.resource.data.description.size() <= 1000));
      allow delete: if isUser(resource.data.ownerId);

      match /routeChunks/{chunkId} {
        allow read: if canSeeActivity(activityId);
        // getAfter: points are written in the same batch as the activity itself.
        allow create: if isUser(getAfter(/databases/$(database)/documents/activities/$(activityId)).data.ownerId)
          && request.resource.data.keys().hasOnly(['index', 'points'])
          && request.resource.data.index is int
          && request.resource.data.points is list
          && request.resource.data.points.size() <= 500;
        allow delete: if isUser(activityData(activityId).ownerId);
        allow update: if false;
      }

      match /likes/{likerId} {
        allow read: if canSeeActivity(activityId);
        allow create: if isUser(likerId) && canSeeActivity(activityId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isUser(likerId);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canSeeActivity(activityId);
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && canSeeActivity(activityId)
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if isUser(resource.data.authorId)
          && changedOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if isUser(resource.data.authorId) || isUser(activityData(activityId).ownerId);
      }
    }

    // ---------- challenges ----------
    // The challenges themselves are a catalogue built into the app; ids look like
    // `run-25-2026-W47` or `ride-400-2026-11`. Each person writes their own entry,
    // and their device keeps its progress in step with their activities.
    function validChallengeId(id) {
      return id.matches('^[a-z0-9-]+-[0-9]{4}-(W[0-9]{2}|[0-9]{2})$') && id.size() <= 60;
    }
    function validEntryName(d) {
      return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && d.username is string && d.username.size() <= 20;
    }
    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create: if isUser(participantId) && validChallengeId(challengeId)
          && request.resource.data.keys().hasOnly(['displayName', 'username', 'progress', 'endsAt', 'joinedAt', 'updatedAt'])
          && validEntryName(request.resource.data)
          && request.resource.data.progress == 0
          && request.resource.data.endsAt is timestamp
          && request.resource.data.endsAt > request.time
          && request.resource.data.endsAt < request.time + duration.value(32, 'd')
          && request.resource.data.joinedAt == request.time
          && request.resource.data.updatedAt == request.time;
        // Progress keeps syncing for 3 days after the end, for activities saved offline.
        allow update: if isUser(participantId)
          && changedOnly(['displayName', 'username', 'progress', 'updatedAt'])
          && validEntryName(request.resource.data)
          && request.resource.data.progress is int
          && request.resource.data.progress >= 0 && request.resource.data.progress <= 100000000
          && request.resource.data.updatedAt == request.time
          && resource.data.endsAt + duration.value(3, 'd') > request.time;
        allow delete: if isUser(participantId);
      }
    }

    // ---------- leaderboards ----------
    // Board ids: `week-2026-W47-run`, `month-2026-11-any`, `all-time-ride`. People
    // write only their own entry, and only while they show on leaderboards.
    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if false;
      match /entries/{entryId} {
        allow read: if signedIn();
        allow create, update: if isUser(entryId)
          && boardId.matches('^(week-[0-9]{4}-W[0-9]{2}|month-[0-9]{4}-[0-9]{2}|all-time)-(any|walk|run|ride)$')
          && get(/databases/$(database)/documents/users/$(entryId)).data.privacy.showOnLeaderboards == true
          && request.resource.data.keys().hasOnly(['displayName', 'username', 'level', 'distanceM', 'count', 'updatedAt'])
          && validEntryName(request.resource.data)
          && request.resource.data.level is int
          && request.resource.data.distanceM is int
          && request.resource.data.distanceM > 0 && request.resource.data.distanceM <= 100000000
          && request.resource.data.count is int && request.resource.data.count > 0
          && request.resource.data.updatedAt == request.time;
        allow delete: if isUser(entryId);
      }
    }
    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- events ----------
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /registrations/{registrantId} {
        allow read: if signedIn();
        allow create: if isUser(registrantId)
          && request.resource.data.keys().hasOnly(['registeredAt'])
          && request.resource.data.registeredAt == request.time
          && get(/databases/$(database)/documents/events/$(eventId)).data.startsAt > request.time;
        allow delete: if isUser(registrantId);
        allow update: if false;
      }
    }
  }
}
