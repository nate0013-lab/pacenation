# Optional. The app already points at the pacenation-958d2 project.
# Fill these in only to point it at a different Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development against the Firebase emulator suite (npm run emulators).
# Set to 1 to ignore the values above and use the emulators.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0
# localhost for web and iOS simulator, 10.0.2.2 for the Android emulator,
# or your computer's LAN IP for a phone on the same Wi-Fi.
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Google sign-in (stage 7). The button stays hidden until the web client ID is set.
# Web client ID: Firebase console > Authentication > Sign-in method > Google > Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Phone builds also need their own OAuth clients from Google Cloud console > Credentials.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Apple sign-in (iOS only): set to 1 after enabling Apple in Firebase Authentication.
EXPO_PUBLIC_APPLE_SIGN_IN=0

# Build-time only (not sent to the app bundle): Google Maps key for Android maps.
GOOGLE_MAPS_ANDROID_KEY=
